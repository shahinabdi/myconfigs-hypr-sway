# ~/.config/mako/config
# Dark, transparent, rounded — matches the swayfx-fedora palette.

sort=-time
layer=overlay
anchor=top-right
margin=10
padding=12
width=320
height=110
border-size=1
border-radius=8
icons=1
max-icon-size=32
default-timeout=5000
ignore-timeout=0

background-color=#121a26f5
text-color=#d6deea
border-color=#273344
progress-color=over #69a7ff

font=JetBrainsMono Nerd Font Mono 10

[urgency=low]
border-color=#273344
default-timeout=3000

[urgency=normal]
border-color=#273344

[urgency=critical]
border-color=#e57373
text-color=#e57373
default-timeout=0
